# Database
POSTGRES_URL=

# Auth (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=                              # Optional: override auto-detected URL

# App URL
NEXT_PUBLIC_APP_URL=                          # Optional: override for local dev

# Vercel OAuth
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Linear OAuth (actor=app workspace installation)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=                        # App-level webhook secret from Linear developer settings

# Voice transcription (optional)
ELEVENLABS_API_KEY=

# Redis / KV (optional)
REDIS_URL=
KV_URL=

# Neon (optional - for DB provisioning in sandboxes)
NEON_PROJECT_ID=
NEON_API_KEY=

# Vercel Sandbox
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=
VERCEL_SANDBOX_TIMEOUT_MS=                    # Optional: override sandbox lifetime (max 5h; leave unset for the default)

# Deployment resource profile (optional)
# Leave UNSET on Pro/Enterprise: 5h sandboxes, 4 vCPUs.
# Set to "hobby" only on a Vercel Hobby account: 40m sandboxes, 1 vCPU.
OPEN_AGENTS_RESOURCE_PROFILE=

# Bot protection (optional)
# Comma-separated extra frontend hosts allowed to call BotID-protected routes,
# e.g. your custom production domain: app.example.com,*.example.com
BOTID_EXTRA_ALLOWED_HOSTS=

# Vercel (auto-set on Vercel deployments)
VERCEL_URL=
VERCEL_ENV=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_PROJECT_PRODUCTION_URL=
