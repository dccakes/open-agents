# Environment variables for the QuackOps web app.
#
# Generated from lib/config/** — do not edit by hand.
# Regenerate with: bun run --cwd apps/web env:example
#
# axis:
#   required-prod  must be set on a production deployment (boot fails without it)
#   optional       feature-gated, or has a working default
#   dev-only       only meaningful in local development
#
# Secrets are left blank on purpose. Never commit real values.

# --- deployment ---

# Node environment. Set by the framework — `development`, `production`, or
# `test`.
# axis: optional
NODE_ENV=development

# Vercel deployment environment (`production`, `preview`, `development`). Set
# automatically by Vercel.
# axis: optional
VERCEL_ENV=

# Hostname of this specific deployment. Set automatically by Vercel.
# axis: optional
VERCEL_URL=

# Production hostname of the project. Set automatically by Vercel.
# axis: optional
VERCEL_PROJECT_PRODUCTION_URL=

# Set to `hobby` to shrink sandbox vCPUs and lifetimes for Vercel Hobby limits.
# axis: optional
OPEN_AGENTS_RESOURCE_PROFILE=standard

# Comma-separated extra frontend hosts allowed to call BotID-protected
# endpoints.
# axis: optional
BOTID_EXTRA_ALLOWED_HOSTS=quackops.example.com,www.quackops.example.com

# --- public ---

# Canonical public origin, e.g. https://quackops.example.com. Used for OAuth
# redirects and Linear webhook registration; falls back to the request origin.
# axis: optional
NEXT_PUBLIC_APP_URL=https://quackops.example.com

# Slug of the GitHub App, used to build install and manage URLs.
# axis: optional | required with GITHUB_APP_ID
NEXT_PUBLIC_GITHUB_APP_SLUG=quackops

# GitHub OAuth client ID used for sign-in and repo access.
# axis: optional | required with GITHUB_CLIENT_SECRET
NEXT_PUBLIC_GITHUB_CLIENT_ID=Iv1.0123456789abcdef

# Vercel OAuth client ID — the primary sign-in provider.
# axis: required-prod
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=oac_0123456789abcdef

# Production hostname exposed to the browser (Vercel sets this automatically).
# Used for share links and PR back-links.
# axis: optional
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=quackops.example.com

# --- auth ---

# Signing key for better-auth sessions; also derives the AES key for the stored
# Linear workspace token.
# axis: required-prod | secret
BETTER_AUTH_SECRET=

# Explicit base URL for better-auth. Falls back to the Vercel deployment URL,
# then the request origin.
# axis: optional
BETTER_AUTH_URL=http://localhost:3000

# Vercel OAuth client secret (pairs with the client ID).
# axis: required-prod | secret
VERCEL_APP_CLIENT_SECRET=

# GitHub OAuth client secret (pairs with the client ID).
# axis: optional | secret | required with NEXT_PUBLIC_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=

# Comma-separated email domains auto-approved into the organization on sign-up.
# Unset means nobody is auto-approved — every sign-up lands pending.
# axis: optional
ALLOWED_EMAIL_DOMAINS=nextdegree.org,example.com

# Comma-separated emails granted platform admin and organization owner on first
# sign-in, so a fresh deployment is never adminless.
# axis: required-prod
ADMIN_EMAILS=admin@nextdegree.org

# Display name of the single seeded organization (default QuackOps).
# axis: optional
DEFAULT_ORG_NAME=QuackOps

# Slug of the single seeded organization; the seeder's idempotency key (default
# quackops).
# axis: optional
DEFAULT_ORG_SLUG=quackops

# --- database ---

# Postgres connection string. Provided automatically by the Neon integration on
# Vercel.
# axis: required-prod | secret
POSTGRES_URL=

# --- github ---

# Numeric ID of the GitHub App used for repository access.
# axis: optional | required with GITHUB_APP_PRIVATE_KEY
GITHUB_APP_ID=123456

# GitHub App private key, either PEM (with escaped newlines) or base64-encoded
# PEM.
# axis: optional | secret | required with GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY=

# Shared secret for GitHub webhook HMAC verification. Without it
# `/api/github/webhook` answers 500.
# axis: optional | secret | required with GITHUB_APP_ID
GITHUB_WEBHOOK_SECRET=

# --- linear ---

# Linear OAuth client ID. Unset disables the Linear connection flow.
# axis: optional
LINEAR_CLIENT_ID=

# Linear OAuth client secret.
# axis: optional | secret | required with LINEAR_CLIENT_ID
LINEAR_CLIENT_SECRET=

# Shared secret for Linear webhook HMAC verification. Without it
# `/api/linear/webhook` answers 500.
# axis: optional | secret | required with LINEAR_CLIENT_ID
LINEAR_WEBHOOK_SECRET=

# --- redis ---

# Redis connection string. Enables rate limiting and workspace status fan-out;
# preferred over KV_URL.
# axis: optional | secret
REDIS_URL=

# Vercel KV connection string, used when REDIS_URL is unset. Provided by the
# Upstash integration.
# axis: optional | secret
KV_URL=

# Milliseconds to wait on a Redis rate-limit check before failing open (default
# 1000).
# axis: optional
RATE_LIMIT_TIMEOUT_MS=1000

# --- sandbox ---

# Backend used to resolve env vars injected into sandboxes: `vercel` or
# `infisical`. Unset disables resolution.
# axis: optional
SANDBOX_ENV_RESOLVER=

# Optional prebuilt snapshot for fresh cloud sandboxes. Unset starts from
# Vercel's standard runtime.
# axis: optional
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=

# Override for the default sandbox lifetime in milliseconds. Ignored when
# non-numeric; clamped to the provider maximum.
# axis: optional
VERCEL_SANDBOX_TIMEOUT_MS=17970000

# Vercel API token used by the `vercel` env resolver to read project
# environment variables.
# axis: optional | secret | required with SANDBOX_ENV_RESOLVER
VERCEL_ACCESS_TOKEN=

# Project whose environment variables the `vercel` env resolver reads.
# axis: optional
VERCEL_PROJECT_ID=

# Vercel team slug for the Vercel sandbox provider. Also settable per user in
# sandbox settings.
# axis: optional
VERCEL_TEAM=

# Infisical service token for the `infisical` env resolver.
# axis: optional | secret
INFISICAL_TOKEN=

# Infisical workspace/project ID for the env resolver.
# axis: optional
INFISICAL_PROJECT_ID=

# Infisical API base URL (default https://app.infisical.com). Set for
# self-hosted instances.
# axis: optional
INFISICAL_BASE_URL=https://app.infisical.com

# Neon API key used to branch a session-scoped database per sandbox.
# axis: optional | secret | required with NEON_PROJECT_ID
NEON_API_KEY=

# Neon project the session database branches are created in.
# axis: optional | required with NEON_API_KEY
NEON_PROJECT_ID=

# Image used by the local Docker sandbox provider (default
# open-agents/sandbox-dev:latest).
# axis: dev-only
DOCKER_SANDBOX_IMAGE=open-agents/sandbox-dev:latest

# Image used to provision a local Postgres for Docker sandboxes (default
# postgres:16-alpine).
# axis: dev-only
DOCKER_POSTGRES_IMAGE=postgres:16-alpine

# User for the locally provisioned Postgres container (default postgres).
# axis: dev-only
DOCKER_POSTGRES_USER=postgres

# Set to `true` or `1` to expose the beta Daytona sandbox provider.
# axis: optional
DAYTONA_BETA_ENABLED=

# Daytona API key. Also settable per user in sandbox settings.
# axis: optional | secret
DAYTONA_API_KEY=

# Daytona server URL. Also settable per user in sandbox settings.
# axis: optional
DAYTONA_SERVER_URL=https://app.daytona.io

# --- agent-policy ---

# Hours a pending approval stays answerable before it is treated as denied
# (default 24).
# axis: optional
AGENT_APPROVAL_TIMEOUT_HOURS=24

# Maximum agent steps a single run may take before it halts (default 500).
# axis: optional
AGENT_RUN_STEP_BUDGET=500

# Maximum tokens a single run may consume before it halts. Unset means
# unlimited; the step budget still bounds the run.
# axis: optional
AGENT_RUN_TOKEN_BUDGET=250000
